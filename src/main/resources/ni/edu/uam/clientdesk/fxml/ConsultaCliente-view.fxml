<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.clientdesk.controller.ConsultaClientesController"
            prefWidth="1000.0"
            prefHeight="650.0"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #d9dee5;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 15 25 15 25;">
            <children>
                <Button fx:id="btnVolver"
                        text="&#8592; Volver"
                        onAction="#onVolver"
                        style="-fx-background-color: #e5e7eb;
                               -fx-text-fill: #374151;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;"/>

                <Label text="Consulta de clientes"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="25.0" right="45.0" bottom="25.0" left="45.0"/>
            </padding>
            <children>

                <!-- Barra de búsqueda / info -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar por nombre..."
                                   onKeyReleased="#onBuscar"
                                   prefWidth="280.0"
                                   style="-fx-background-radius: 6; -fx-border-color: #d9dee5; -fx-border-radius: 6;"/>

                        <Label fx:id="lblTotal" text="0 clientes registrados"
                               style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                    </children>
                </HBox>

                <!-- Tarjeta contenedora de la tabla -->
                <VBox spacing="10.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10;
                             -fx-border-color: #d9dee5;
                             -fx-border-radius: 10;
                             -fx-padding: 20;">
                    <children>

                        <Label text="Doble clic sobre un cliente para ver el detalle"
                               style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>

                        <TableView fx:id="tblClientes"
                                   onMouseClicked="#onTablaClick"
                                   VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colNombreCompleto" text="Nombre completo" prefWidth="220.0"/>
                                <TableColumn fx:id="colTipoCliente" text="Tipo de cliente" prefWidth="150.0"/>
                                <TableColumn fx:id="colCiudad" text="Ciudad" prefWidth="150.0"/>
                                <TableColumn fx:id="colFechaNacimiento" text="Fecha de nacimiento" prefWidth="170.0"/>
                                <TableColumn fx:id="colTipoSolicitud" text="Tipo de solicitud" prefWidth="150.0"/>
                            </columns>
                        </TableView>

                    </children>
                </VBox>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #d9dee5;
                     -fx-border-width: 1 0 0 0;
                     -fx-padding: 12 25 12 25;">
            <children>
                <Button fx:id="btnVerDetalle"
                        text="Ver detalle"
                        onAction="#onVerDetalle"
                        prefWidth="150.0" prefHeight="36.0"
                        style="-fx-background-color: #0097a7;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>