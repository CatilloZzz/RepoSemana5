<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.clientdesk.controller.LoginController"
            prefWidth="700.0"
            prefHeight="450.0"
            style="-fx-background-color: #f4f6f8;">

    <center>

        <VBox alignment="CENTER"
              maxWidth="420.0"
              spacing="20.0"
              style="-fx-background-color: white;
                     -fx-background-radius: 12;
                     -fx-border-color: #d9dee5;
                     -fx-border-radius: 12;
                     -fx-padding: 40;">

            <children>

                <Label text="Inicio de sesión"
                       style="-fx-font-size: 28px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f2937;"/>

                <Label text="Ingrese sus datos para acceder al sistema"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: #6b7280;"/>

                <VBox spacing="7.0"
                      maxWidth="320.0">

                    <children>

                        <Label text="Usuario"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #374151;"/>

                        <TextField fx:id="txtUsuario"
                                   promptText="Ingrese su usuario"
                                   prefHeight="40.0"
                                   maxWidth="Infinity"
                                   style="-fx-background-color: #f9fafb;
                                          -fx-border-color: #cbd5e1;
                                          -fx-border-radius: 7;
                                          -fx-background-radius: 7;
                                          -fx-padding: 0 12 0 12;
                                          -fx-font-size: 14px;"/>

                    </children>

                </VBox>

                <VBox spacing="7.0"
                      maxWidth="320.0">

                    <children>

                        <Label text="Contraseña"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #374151;"/>

                        <PasswordField fx:id="txtPassword"
                                       promptText="Ingrese su contraseña"
                                       prefHeight="40.0"
                                       maxWidth="Infinity"
                                       onKeyPressed="#onPasswordKeyPressed"
                                       style="-fx-background-color: #f9fafb;
                                              -fx-border-color: #cbd5e1;
                                              -fx-border-radius: 7;
                                              -fx-background-radius: 7;
                                              -fx-padding: 0 12 0 12;
                                              -fx-font-size: 14px;"/>

                    </children>

                </VBox>

                <HBox alignment="CENTER"
                      spacing="12.0"
                      maxWidth="320.0">

                    <children>

                        <Button fx:id="btnIniciarSesion"
                                text="Iniciar sesión"
                                prefHeight="40.0"
                                prefWidth="180.0"
                                onAction="#onIniciarSesion"
                                defaultButton="true"
                                style="-fx-background-color: #0097a7;
                                       -fx-text-fill: white;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 7;
                                       -fx-cursor: hand;"/>

                        <Button fx:id="btnSalir"
                                text="Salir"
                                prefHeight="40.0"
                                prefWidth="100.0"
                                onAction="#onSalir"
                                cancelButton="true"
                                style="-fx-background-color: #e5e7eb;
                                       -fx-text-fill: #374151;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 7;
                                       -fx-cursor: hand;"/>

                    </children>

                </HBox>

            </children>

        </VBox>

    </center>

    <bottom>

        <Label text="ClientDesk"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #9ca3af;
                      -fx-padding: 0 0 15 0;"/>

    </bottom>

</BorderPane>